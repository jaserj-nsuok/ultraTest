    <script>

        // ===== STATE =====
        let currentScreen = '0';
        let chosenPath = null;
        const visitedScreens = new Set();

        // Screen flow map
        const screenOrder = {
            '0': null,
            '1': '0', '2': '1', '3': '2',
            '4a': '3', '4b': '4a',
            '5a': '3', '5b': '5a',
            '6a': '3', '6b': '6a',
            '7': null, '8': '7', '9': '8', '10': '9'
        };

        // Progress calculation
        function getProgress(screen) {
            const flows = {
                A: ['0','1','2','3','4a','4b','7','8','9','10'],
                B: ['0','1','2','3','5a','5b','7','8','9','10'],
                C: ['0','1','2','3','6a','6b','7','8','9','10'],
            };
            const flow = chosenPath ? flows[chosenPath] : ['0','1','2','3','?','?','7','8','9','10'];
            const idx = flow.indexOf(screen);
            if (idx === -1) return 0;
            return Math.round((idx / (flow.length - 1)) * 100);
        }

        // Progress dots: 5 phases
        function getPhase(screen) {
            if (screen === '0') return 0;
            if (['1','2'].includes(screen)) return 1;
            if (screen === '3') return 2;
            if (['4a','4b','5a','5b','6a','6b'].includes(screen)) return 3;
            return 4;
        }

        function renderDots() {
            const phase = getPhase(currentScreen);
            const container = document.getElementById('progress-dots-c7m2');
            container.innerHTML = '';
            for (let i = 0; i < 5; i++) {
                const dot = document.createElement('div');
                dot.className = 'progress-dot';
                if (i < phase) dot.classList.add('completed');
                else if (i === phase) dot.classList.add('active');
                else dot.classList.add('future');
                dot.setAttribute('aria-hidden','true');
                container.appendChild(dot);
            }
        }

        function renderPathBadge() {
            const el = document.getElementById('path-badge-p3k1');
            if (!chosenPath) { el.classList.add('hidden'); return; }
            el.classList.remove('hidden');
            const cfg = { A: { bg:'bg-pathgreen/20', text:'text-pathgreen', label:'Path 2A ✓' }, B: { bg:'bg-pathamber/20', text:'text-pathamber', label:'Path 2B ✓' }, C: { bg:'bg-pathred/20', text:'text-pathred', label:'Path 2C ✓' } };
            const c = cfg[chosenPath];
            el.className = `badge-chip ${c.bg} ${c.text}`;
            el.textContent = c.label;
        }

        function updateHeader() {
            const labels = {
                '0': '', '1': 'Document 1', '2': 'Document 1', '3': 'Decision Point',
                '4a': 'Path 2A', '4b': 'Path 2A', '5a': 'Path 2B', '5b': 'Path 2B',
                '6a': 'Path 2C', '6b': 'Path 2C', '7': 'Final Debrief', '8': 'Final Debrief',
                '9': 'Final Debrief', '10': 'Final Debrief'
            };
            document.getElementById('header-doc-label-d9f2').textContent = labels[currentScreen] || '';
            document.getElementById('progress-bar-b4n1').style.width = getProgress(currentScreen) + '%';
            renderDots();
            renderPathBadge();
            const flows = {A:['0','1','2','3','4a','4b','7','8','9','10'],B:['0','1','2','3','5a','5b','7','8','9','10'],C:['0','1','2','3','6a','6b','7','8','9','10']};
            const flow = chosenPath ? flows[chosenPath] : ['0','1','2','3','4a','4b','7','8','9','10'];
            const idx = Math.max(0, flow.indexOf(currentScreen));
            const ps = document.getElementById('progress-status');
            if (ps) ps.textContent = `Step ${idx + 1} of ${flow.length}`;
        }

        function highlightChosenColumn() {
            ['a','b','c'].forEach(letter => {
                const col = document.getElementById(`col-${letter}-${{a:'h8k2',b:'m3j7',c:'n1q5'}[letter]}`);
                const pathLetter = letter.toUpperCase();
                if (chosenPath === pathLetter) {
                    col.classList.add('highlight-col');
                    for (let i = 1; i <= 5; i++) {
                        const cell = document.getElementById(`cell-${letter}${i}`);
                        if (cell) cell.classList.add('highlight-col');
                    }
                } else {
                    col.classList.remove('highlight-col');
                    for (let i = 1; i <= 5; i++) {
                        const cell = document.getElementById(`cell-${letter}${i}`);
                        if (cell) cell.classList.remove('highlight-col');
                    }
                }
            });
        }

        function navigateTo(screen) {
            const cur = document.getElementById(`screen-${currentScreen}`);
            if (cur) {
                cur.classList.remove('active');
                cur.setAttribute('aria-hidden', 'true');
            }
            currentScreen = screen;
            visitedScreens.add(screen);
            const next = document.getElementById(`screen-${screen}`);
            if (next) {
                next.classList.add('active');
                next.setAttribute('aria-hidden', 'false');
            }
            updateHeader();
            if (screen === '7') highlightChosenColumn();
            if (screen === '10') {
                const lbl = document.getElementById('final-path-label-f3z9');
                const pathLabels = { A: 'You chose Path 2A — Conservative Management', B: 'You chose Path 2B — Imaging First', C: 'You chose Path 2C — Rest and Return' };
                lbl.textContent = chosenPath ? pathLabels[chosenPath] : '';
            }
            if (next) {
                const heading = next.querySelector('h1, h2, h3');
                const focusTarget = heading || next;
                if (!focusTarget.hasAttribute('tabindex')) focusTarget.setAttribute('tabindex', '-1');
                focusTarget.focus({ preventScroll: true });
                const status = document.getElementById('sr-status');
                if (status) status.textContent = heading ? `Now showing: ${heading.textContent.trim()}` : 'New vignette screen loaded';
            }
            window.scrollTo({ top: 0, behavior: 'auto' });
        }

        function choosePath(path) {
            chosenPath = path;
            const cardIds = { A: 'card-a-r4m2', B: 'card-b-k8n3', C: 'card-c-j5p7' };
            const card = document.getElementById(cardIds[path]);
            card.classList.add('selected-ring');

            // Add shimmer
            const shimmer = document.createElement('div');
            shimmer.className = 'shimmer-overlay';
            card.style.position = 'relative';
            card.appendChild(shimmer);

            // Disable all path buttons
            document.querySelectorAll('.path-btn').forEach(btn => {
                btn.disabled = true;
                btn.style.opacity = '0.5';
                btn.style.pointerEvents = 'none';
            });

            const screenMap = { A: '4a', B: '5a', C: '6a' };
            setTimeout(() => {
                shimmer.remove();
                navigateTo(screenMap[path]);
            }, 500);
        }

        // ===== EVENT LISTENERS =====

        // Begin button
        document.getElementById('btn-begin-x2k9').addEventListener('click', () => navigateTo('1'));

        // Nav buttons
        document.querySelectorAll('.nav-btn').forEach(btn => {
            btn.addEventListener('click', () => navigateTo(btn.dataset.to));
        });

        // Back buttons
        document.querySelectorAll('.back-btn').forEach(btn => {
            btn.addEventListener('click', () => navigateTo(btn.dataset.to));
        });

        // Path choice buttons
        document.querySelectorAll('.path-btn').forEach(btn => {
            btn.addEventListener('click', () => choosePath(btn.dataset.path));
        });

        // Restart
        document.getElementById('btn-restart-v7w1').addEventListener('click', () => {
            chosenPath = null;
            visitedScreens.clear();
            // Re-enable path buttons
            document.querySelectorAll('.path-btn').forEach(btn => {
                btn.disabled = false;
                btn.style.opacity = '1';
                btn.style.pointerEvents = 'auto';
            });
            // Remove selected ring from cards
            document.querySelectorAll('.selected-ring').forEach(el => el.classList.remove('selected-ring'));
            navigateTo('0');
        });

        // Accordions
        document.querySelectorAll('.accordion-toggle').forEach(toggle => {
            toggle.addEventListener('click', () => {
                const content = toggle.nextElementSibling;
                const icon = toggle.querySelector('[data-lucide="chevron-down"]');
                content.classList.toggle('open');
                toggle.setAttribute('aria-expanded', content.classList.contains('open') ? 'true' : 'false');
                if (icon) {
                    icon.style.transform = content.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0deg)';
                }
            });
        });

        // Red flag cards
        document.querySelectorAll('.red-flag-card').forEach(card => {
            card.addEventListener('click', () => {
                const detail = card.querySelector('.red-flag-detail');
                if (detail) {
                    detail.classList.toggle('open');
                    card.setAttribute('aria-expanded', detail.classList.contains('open') ? 'true' : 'false');
                }
            });
        });

        // ===== INIT =====
        navigateTo('0');
    </script>
</div>
